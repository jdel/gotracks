# Copy to .env and adjust.
#
# Every flag has an environment equivalent: the GOTRACKS_ prefix, with dots and
# dashes replaced by underscores. So --auth.jwt-secret is GOTRACKS_AUTH_JWT_SECRET.

# Signing key for access tokens. Generate one with:
#   openssl rand -hex 32
# If left empty the server generates a temporary key at startup and every
# restart signs everyone out.
GOTRACKS_AUTH_JWT_SECRET=
# Required while the database has no users. Generate separately with the same
# command, enter it on the first registration form, then remove it.
GOTRACKS_AUTH_BOOTSTRAP_SECRET=

GOTRACKS_ADDR=:8080
GOTRACKS_LOG_LEVEL=info
# text (human-readable) or json (for log shippers)
GOTRACKS_LOG_FORMAT=json

# Seeds public registration after bootstrap; afterwards an admin toggles it in
# the UI and the stored value wins. Disabled by default.
GOTRACKS_AUTH_ALLOW_REGISTER=false

# Token lifetimes.
# GOTRACKS_AUTH_ACCESS_TTL=15m
# GOTRACKS_AUTH_REFRESH_TTL=720h

# Per-client rate limiting.
# GOTRACKS_RATE_RPS=20
# GOTRACKS_RATE_BURST=40

# Attachments.
# GOTRACKS_STORAGE_MAX_UPLOAD_MB=10

# Passkeys (WebAuthn). Both are required to enable them.
# RP_ID is the bare domain; RP_ORIGIN the full origin (comma-separated for several).
# WebAuthn requires HTTPS, except on localhost.
# GOTRACKS_WEBAUTHN_RP_ID=tracks.example.com
# GOTRACKS_WEBAUTHN_RP_ORIGIN=https://tracks.example.com
# GOTRACKS_WEBAUTHN_RP_NAME=gotracks

# OIDC single sign-on. All four are required to enable it.
# GOTRACKS_OIDC_ISSUER=
# GOTRACKS_OIDC_CLIENT_ID=
# GOTRACKS_OIDC_CLIENT_SECRET=
# GOTRACKS_OIDC_REDIRECT_URL=https://tracks.example.com/api/v1/auth/oidc/callback
